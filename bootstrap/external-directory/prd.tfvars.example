environment           = "prd"
external_tenant_id    = "<prd-external-tenant-id>"
tenant_subdomain      = "<prd-tenant-subdomain>"
tenant_primary_domain = "<prd-tenant-subdomain>.onmicrosoft.com"
tenant_data_location  = "<prd-external-tenant-location>"
mobile_redirect_uri   = "<prd-mobile-redirect-uri>"

# Explicitly override any development auto.tfvars values during the first Email OTP baseline apply.
# Replace each null only after its matching production provider workflow succeeds so Terraform
# retains the production association during later directory-root plans.
google_identity_provider_id = null
apple_identity_provider_id  = null
