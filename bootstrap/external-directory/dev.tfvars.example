environment           = "dev"
external_tenant_id    = "<dev-external-tenant-id>"
tenant_subdomain      = "<dev-external-tenant-subdomain>"
tenant_primary_domain = "<dev-external-tenant-subdomain>.onmicrosoft.com"
tenant_data_location  = "<dev-external-tenant-location>"
mobile_redirect_uri   = "<dev-mobile-redirect-uri>"

# Leave both provider IDs unset for the first Email OTP baseline apply. After each provider workflow succeeds,
# uncomment its matching non-secret ID before any later plan so Terraform retains every association.
# google_identity_provider_id = "<dev-google-identity-provider-object-id>"

# apple_identity_provider_id = "<dev-apple-identity-provider-object-id>"
